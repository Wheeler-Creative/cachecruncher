{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "cachecruncher-request",
  "main": "src/worker.js",
  "compatibility_date": "2026-04-03",
  "workers_dev": true,
  "observability": {
    "enabled": true
  },
  "assets": {
    "directory": "public",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application"
  }
}
