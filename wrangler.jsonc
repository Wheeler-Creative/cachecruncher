{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "cachecruncher",
  "main": "src/worker.js",
  "workers_dev": true,
  "compatibility_date": "2026-08-06",
  "observability": {
    "enabled": true
  },
  "assets": {
    "directory": "dist",
    "binding": "ASSETS",
    "run_worker_first": [
      "/*",
      "!/styles.css",
      "!/app.js",
      "!/site-modules.js",
      "!/site-behaviors.js"
    ],
    "not_found_handling": "single-page-application"
  },
  "r2_buckets": [
    {
      "binding": "MEDIA",
      "bucket_name": "sharedbucket"
    }
  ],
  "routes": [
    {
      "pattern": "cachecruncher.com",
      "custom_domain": true
    },
    {
      "pattern": "www.cachecruncher.com",
      "custom_domain": true
    }
  ],
  "kv_namespaces": [
    {
      "binding": "cachecruncher_feedback",
      "id": "cd79582eee82452dbc90facc318ba4a4",
      "remote": true
    }
  ],
  "compatibility_flags": [
    "nodejs_compat"
  ],
  "images": {
    "binding": "IMAGES"
  },
  "ratelimits": [
    {
      "name": "CONTACT_ACTOR_RATE",
      "namespace_id": "92001",
      "simple": {
        "limit": 10,
        "period": 60
      }
    },
    {
      "name": "CONTACT_SITE_RATE",
      "namespace_id": "92002",
      "simple": {
        "limit": 100,
        "period": 60
      }
    },
    {
      "name": "CUSTOMER_ACCOUNT_ACTOR_RATE",
      "namespace_id": "92007",
      "simple": {
        "limit": 120,
        "period": 60
      }
    },
    {
      "name": "CUSTOMER_ACCOUNT_SITE_RATE",
      "namespace_id": "92008",
      "simple": {
        "limit": 1000,
        "period": 60
      }
    }
  ],
  "rules": [
    {
      "type": "Text",
      "globs": [
        "**/site-api.js"
      ],
      "fallthrough": false
    }
  ],
  "worker_loaders": [
    {
      "binding": "SITE_API"
    }
  ],
  "analytics_engine_datasets": [
    {
      "binding": "FORM_CHECKS",
      "dataset": "jaybird_form_checks"
    }
  ]
}
